{
  "description": "tidy：会话开始注入整洁规范与目录约定；拦截不合规的新文件；每轮结束检查新增文件",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/tidy/scripts/hook.py\" session-start", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/tidy/scripts/hook.py\" pre-write", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/tidy/scripts/hook.py\" stop", "timeout": 20 }
        ]
      }
    ]
  }
}
